{
	"name": "@rayven/plane-mcp-gateway",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "wrangler deploy --dry-run --env=\"\" --outdir dist",
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "vitest run",
		"type-check": "tsc --noEmit",
		"check": "npm run lint && npm run type-check && npm test && npm run build",
		"security:sentinel": "node scripts/check-sentinel.mjs"
	},
	"dependencies": {
		"@modelcontextprotocol/server": "2.0.0",
		"agents": "0.22.0",
		"jose": "6.2.12",
		"zod": "4.5.4"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@cloudflare/workers-types": "5.20260908.1",
		"typescript": "5.9.3",
		"vitest": "5.0.0",
		"wrangler": "4.129.1"
	},
	"engines": {
		"node": ">=22"
	}
}
